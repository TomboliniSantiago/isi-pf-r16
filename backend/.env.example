# Copiar a backend/.env y completar. backend/.env NO se versiona.

# --- Base de datos (Azure SQL / SQL Server) ---
DB_HOST=<servidor>.database.windows.net
DB_PORT=1433
DB_NAME=pfinalbasedd
DB_USER=
DB_PASSWORD=
# Solo para servidores locales con certificado autofirmado
DB_TRUST_CERT=no
# Alternativa: URL completa de SQLAlchemy (tiene prioridad sobre DB_*)
# DATABASE_URL=

# --- Autenticación ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
LOGIN_MAX_INTENTOS=3
LOGIN_BLOQUEO_MINUTOS=15

# --- Códigos de verificación por correo (2FA, recupero y cambio de contraseña) ---
CODIGO_VIGENCIA_MINUTOS=10
CODIGO_MAX_INTENTOS=5
CODIGO_REENVIO_SEGUNDOS=60

# --- Envío de correo ---
# consola: el correo (con el código) se escribe en la consola del backend. Para desarrollo.
# smtp:    se envía con el servidor SMTP configurado abajo.
CORREO_MODO=consola
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=
# starttls (puerto 587) | ssl (puerto 465) | ninguna
SMTP_SEGURIDAD=starttls
